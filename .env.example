# Copier vers .env et renseigner les valeurs (ne jamais committer .env)
# cp .env.example .env

# URL de base de l'API backend (Django)
VITE_API_BASE_URL=http://localhost:8000

# Timeout des requêtes HTTP en millisecondes (défaut : 30000)
VITE_API_TIMEOUT=30000

# Observabilité Sentry (optionnel)
# VITE_SENTRY_DSN=https://example@o0.ingest.sentry.io/0
